/*==============================================================================
  Program   : 06b_plasmode.sas
  Project   : synpuf-survival-sas
  Purpose   : Plasmode simulation. Keeps the real covariates of the primary
              cohort and replaces the outcome with survival times generated
              from a model whose parameters are known, so that the Cox models
              and the diagnostics in 07 to 09 can be checked against the truth.
  Inputs    : SYNWORK.ANALYSIS (covariates only, the real outcome is not used)
  Outputs   : SYNWORK.PLASMODE   one simulated outcome per cohort member
              SYNWORK.PLAS_TRUTH  results/tables/plasmode_truth.csv
              SYNWORK.PLAS_SUMMARY results/tables/plasmode_summary.csv
              SYNWORK.PLAS_RECOVERY results/tables/plasmode_recovery.csv
              SYNWORK.PLAS_REPS    results/tables/plasmode_replicates.csv
              results/figures/plasmode_chf_tv.png
  Seminar   : sections 5.5 (time-varying effects) and 6 to 8, which use these
              data in 07 to 09
  Notes     : Design (every true value is set in section 4b of 00_config.sas
              and listed in docs/methods.md)
                - Weibull baseline hazard with shape plas_shape. The scale is
                  calibrated below so that the expected two-year mortality of
                  this cohort is plas_target.
                - CHF log hazard ratio a + b * log(t), t in days, which decays
                  from about 2.5 at one month to 1.3 at two years. Because the
                  CHF term only changes the Weibull shape for people with CHF,
                  the cumulative hazard has a closed form and survival times
                  are generated by inverting it.
                - Quadratic age effect, diabetes HR 1.3, female HR 0.8, and no
                  effect for every other covariate.
                - Light exponential random censoring, plus administrative
                  censoring at day 730.
                - Each simulated date is coarsened to the first of its month,
                  which reproduces the date resolution of DE-SynPUF. The daily
                  time (TIME_DAY) is kept as well, to separate the effect of
                  monthly dates from the effect of the ties method.
              Random draws. Every uniform number comes from %hash_u in
              00_config.sas, which hashes the beneficiary ID, the seed
              (&seed), and a draw number k with MD5. The data are therefore
              the same on every SAS release and platform, and the Python
              cross-check builds an identical data set, so every model fitted
              to these data is compared with Python to full precision.
                k = 0          orders people for the fixed subsamples
                k = 1, 2       event time and censoring time of the main data
                k = 2r+1, 2r+2 the same for replicate r of the replicate study
              Section 2b compares the first uniforms with Python directly.
==============================================================================*/

/*------------------------------------------------------------------------------
  Load 00_config.sas from this program's folder every time, so the program
  can run alone or from run_all.sas and always sees the current settings.
------------------------------------------------------------------------------*/
%macro _boot;
  %local p;
  %if %symexist(_SASPROGRAMFILE) %then %let p = %qsysfunc(dequote(&_SASPROGRAMFILE));
  %if %length(&p) = 0 and %sysfunc(envlen(SAS_EXECFILEPATH)) > 0 %then
    %let p = %qsysfunc(sysget(SAS_EXECFILEPATH));
  %if %length(&p) = 0 %then %do;
    %put ERROR: [boot] Program location unknown. Open this file from disk in SAS.;
    %return;
  %end;
  %include "%unquote(%qsubstr(&p, 1, %sysfunc(findc(&p, %str(\/), b))))00_config.sas";
%mend _boot;
%_boot

/* Covariates of the recovery model. CHF_LT is the CHF by log(time) term,
   created by a programming statement inside PROC PHREG. */
%let plcovs = chf agec agec2 female race_black race_other race_hisp esrd
              alzh ckd cancer copd depress diab ihd osteo raoa stroke logreimb;
%let plvars = chf_lt &plcovs;

/*------------------------------------------------------------------------------
  1. Real covariates and the linear predictor of the true model.
     For a person with linear predictor eta and Weibull shape k_i,
       H(t) = lambda * k * exp(eta) * t**k_i / k_i,  k_i = k + b * chf,
     because exp(b * log(t)) = t**b. H730 below is H(730) / lambda.
------------------------------------------------------------------------------*/
data synwork._plbase;
  set synwork.analysis(keep=DESYNPUF_ID chf age age_int female race esrd alzh ckd
                            cancer copd depress diab ihd osteo raoa stroke logreimb);
  sel_u = %hash_u(0);
  agec  = age - 75;
  agec2 = agec**2;
  race_black = (race = 2);
  race_other = (race = 3);
  race_hisp  = (race = 5);
  eta0  = &plas_chf_a * chf + &plas_age1 * agec + &plas_age2 * agec2
        + log(&plas_hr_diab) * diab + log(&plas_hr_female) * female;
  shape = &plas_shape + &plas_chf_b * chf;
  h730  = &plas_shape * exp(eta0) * &admin_day**shape / shape;
  label agec = 'Age minus 75 (years)' agec2 = 'Age minus 75, squared';
run;
%nobs(synwork._plbase, plas_n)
%check(metric=plas_n, actual=&plas_n)

/*------------------------------------------------------------------------------
  2. Calibrate the Weibull scale. Bisection on log(lambda) until the mean of
     1 - exp(-lambda * H730) over the cohort equals plas_target. This is the
     expected two-year mortality before random censoring, and it involves no
     random numbers, so it is compared with the Python reference exactly.
------------------------------------------------------------------------------*/
%global plas_loglam;
data _null_;
  array g[&plas_n] _temporary_;
  do i = 1 to &plas_n;
    set synwork._plbase(keep=h730) point=i;
    g[i] = h730;
  end;
  lo = -20;
  hi = 0;
  do iter = 1 to 200 while (hi - lo > 1e-13);
    mid = (lo + hi) / 2;
    m = 0;
    do i = 1 to &plas_n;
      m = m + (1 - exp(-exp(mid) * g[i]));
    end;
    m = m / &plas_n;
    if m > &plas_target then hi = mid;
    else lo = mid;
  end;
  call symputx('plas_loglam', put((lo + hi) / 2, best32.), 'G');
  stop;
run;
%put NOTE: [plasmode] Calibrated log(lambda) = &plas_loglam;

proc sql noprint;
  select mean(1 - exp(-exp(&plas_loglam) * h730)) format=best16.
    into :_em_all trimmed from synwork._plbase;
  select mean(1 - exp(-exp(&plas_loglam) * h730)) format=best16.
    into :_em_chf1 trimmed from synwork._plbase where chf = 1;
  select mean(1 - exp(-exp(&plas_loglam) * h730)) format=best16.
    into :_em_chf0 trimmed from synwork._plbase where chf = 0;
quit;
%check(metric=plas_loglambda,         actual=&plas_loglam, tol=1e-8)
%check(metric=plas_expected_mort_all,  actual=&_em_all,  tol=1e-8)
%check(metric=plas_expected_mort_chf1, actual=&_em_chf1, tol=1e-8)
%check(metric=plas_expected_mort_chf0, actual=&_em_chf0, tol=1e-8)

/*------------------------------------------------------------------------------
  2b. Self-test of the hashed uniforms. For the five smallest beneficiary IDs
      and draws k = 0, 1, 2, the 52-bit integer H must equal the Python value
      exactly. The uniform is compared to 1e-12, because a macro variable
      carries only about 15 significant digits of it. Every value derived
      from the uniforms is checked to full precision further down.
------------------------------------------------------------------------------*/
proc sort data=synwork._plbase(keep=DESYNPUF_ID) out=synwork._hs;
  by DESYNPUF_ID;
run;
data synwork._hash_selftest;
  set synwork._hs(obs=5);
  i = _n_;
  do k = 0 to 2;
    h = input(substr(put(md5(cats(DESYNPUF_ID, &seed, k)), $hex32.), 1, 13), hex13.);
    u = %hash_u(k);
    output;
  end;
  keep i k h u;
  format h 16. u 18.16;
run;
data _null_;
  set synwork._hash_selftest;
  call execute(cats('%nrstr(%check)(metric=plas_hash_h_i', i, '_k', k,
                    ', actual=', put(h, 16.), ', tol=0)'));
  call execute(cats('%nrstr(%check)(metric=plas_hash_u_i', i, '_k', k,
                    ', actual=', put(u, best32.), ', tol=1e-12)'));
run;

/*------------------------------------------------------------------------------
  3. Generate the outcome. One uniform gives the event time by inverting
     H(t). A second uniform gives an exponential random censoring time. Day 1 is
     January 1, 2009, so ceil(x) is the day on which the time falls, and the
     first of that month is the coarsened date.
       CENSOR_TYPE  0 = death, 1 = random censoring, 2 = administrative (day 730)
------------------------------------------------------------------------------*/
%macro _plas_generate(ku, kc);
  t_true = (-log(%hash_u(&ku)) * shape
            / (exp(&plas_loglam) * &plas_shape * exp(eta0))) ** (1 / shape);
  c_true = -log(%hash_u(&kc)) / _crate;
  x = min(t_true, c_true);
  event = (t_true <= c_true and t_true <= &admin_day);
  if event = 0 and x >= &admin_day then do;
    time_day = &admin_day;
    time     = &admin_day;
    censor_type = 2;
  end;
  else do;
    time_day = max(1, ceil(x));
    time     = intnx('month', &origin_dt + time_day, 0, 'b') - &origin_dt;
    censor_type = 1 - event;
  end;
%mend _plas_generate;

data synwork.plasmode;
  set synwork._plbase;
  retain _crate;
  if _n_ = 1 then _crate = -log(1 - &plas_cens_2yr) / &admin_day;
  %_plas_generate(1, 2)
  label time        = 'Days to the first of the month of death or censoring'
        time_day    = 'Days to death or censoring (daily resolution)'
        event       = 'Simulated death'
        censor_type = '0 = death, 1 = random censoring, 2 = administrative';
  drop _crate x t_true c_true eta0 shape h730;
run;

/*------------------------------------------------------------------------------
  4. What was generated. Aggregate counts only.
------------------------------------------------------------------------------*/
proc sql;
  create table synwork.plas_summary as
  select count(*)                                  as n,
         sum(event)                                as deaths,
         mean(event)                               as mortality format=8.4,
         sum(event * chf) / sum(chf)               as mortality_chf format=8.4,
         sum(event * (1 - chf)) / sum(1 - chf)     as mortality_nochf format=8.4,
         sum(censor_type = 1)                      as random_censored,
         sum(censor_type = 2)                      as admin_censored,
         count(distinct case when event = 1 then time end)     as event_times_monthly,
         count(distinct case when event = 1 then time_day end) as event_times_daily,
         sum(time)                                 as sum_time,
         sum(time_day)                             as sum_time_day,
         &plas_loglam                              as log_lambda format=best12.
  from synwork.plasmode;
quit;

title 'Plasmode data: deaths and censoring';
proc print data=synwork.plas_summary noobs;
run;
title;
%export_csv(data=synwork.plas_summary, name=plasmode_summary)

proc sql noprint;
  select mortality format=best16., event_times_monthly
    into :_pm trimmed, :_pet trimmed
  from synwork.plas_summary;
quit;
/* Because the draws are hashed from the ID, Python builds the same data set,
   so these counts must match exactly. */
data _null_;
  set synwork.plas_summary;
  array v[*] deaths random_censored admin_censored event_times_monthly
             event_times_daily sum_time sum_time_day;
  do j = 1 to dim(v);
    call execute(cats('%nrstr(%check)(metric=plas_', lowcase(vname(v[j])),
                      ', actual=', put(v[j], best16.), ')'));
  end;
run;
/* The design asks for about 15 to 20 percent two-year mortality. */
%check_range(metric=plas_mortality,          actual=&_pm,  lo=0.15, hi=0.20)
%check_range(metric=plas_event_times_monthly, actual=&_pet, lo=24,   hi=24)

/*------------------------------------------------------------------------------
  5. The true parameters, one row per coefficient of the recovery model.
     Covariates with no effect have a true coefficient of 0.
------------------------------------------------------------------------------*/
%macro _t(p, v, d);
  ord + 1; param = "&p"; truth = &v; description = &d; output;
%mend _t;

data synwork.plas_truth;
  length param $32 description $80;
  ord = 0;
  %_t(chf,        &plas_chf_a,               'CHF intercept a (log HR at time t is a + b log t)')
  %_t(chf_lt,     &plas_chf_b,               'CHF by log(time) slope b')
  %_t(agec,       &plas_age1,                'Age minus 75 (linear term)')
  %_t(agec2,      &plas_age2,                'Age minus 75 squared')
  %_t(female,     log(&plas_hr_female),      'Female (HR 0.8)')
  %_t(diab,       log(&plas_hr_diab),        'Diabetes (HR 1.3)')
  %_t(race_black, 0, 'No effect')
  %_t(race_other, 0, 'No effect')
  %_t(race_hisp,  0, 'No effect')
  %_t(esrd,       0, 'No effect')
  %_t(alzh,       0, 'No effect')
  %_t(ckd,        0, 'No effect')
  %_t(cancer,     0, 'No effect')
  %_t(copd,       0, 'No effect')
  %_t(depress,    0, 'No effect')
  %_t(ihd,        0, 'No effect')
  %_t(osteo,      0, 'No effect')
  %_t(raoa,       0, 'No effect')
  %_t(stroke,     0, 'No effect')
  %_t(logreimb,   0, 'No effect')
  format truth 10.6;
run;
%export_csv(data=synwork.plas_truth, name=plasmode_truth)

/*------------------------------------------------------------------------------
  6. Recovery on the full plasmode cohort. Four fits of the true model form:
       DE  daily dates,   Efron ties,   chf_lt = chf * log(time)
       ME  monthly dates, Efron ties,   chf_lt = chf * log(time)
       MB  monthly dates, Breslow ties, chf_lt = chf * log(time)
       MM  monthly dates, Efron ties,   chf_lt = chf * log(time + 15)
     DE against ME isolates the cost of monthly dates. ME against MB isolates
     the ties method. MM evaluates the log(time) term at the middle of the
     month (the 16th) instead of the first, which is where a death recorded
     on the first of the month actually happened on average.
------------------------------------------------------------------------------*/
%macro plas_fit(spec=, tvar=, ties=, off=0, data=synwork.plasmode, by=, out=);
  proc phreg data=&data;
    %if %length(&by) %then %do; by &by; %end;
    model &tvar * event(0) = &plvars / ties=&ties gconv=1e-12;
    chf_lt = chf * log(&tvar + &off);
  run;
%mend plas_fit;

%macro plas_full(spec=, tvar=, ties=, off=0, title=);
  title "Plasmode recovery model: &title";
  ods output ParameterEstimates = synwork._ppe_&spec FitStatistics = synwork._pfit_&spec;
  %plas_fit(spec=&spec, tvar=&tvar, ties=&ties, off=&off)
  title;
%mend plas_full;

%plas_full(spec=DE, tvar=time_day, ties=efron,   title=daily dates and Efron ties)
%plas_full(spec=ME, tvar=time,     ties=efron,   title=monthly dates and Efron ties)
%plas_full(spec=MB, tvar=time,     ties=breslow, title=monthly dates and Breslow ties)
%plas_full(spec=MM, tvar=time,     ties=efron,   off=15,
           title=monthly dates and Efron ties with log(time + 15))

data synwork._prec;
  length spec $2 spec_label $56 Parameter $32 Label $256;
  set synwork._ppe_DE(in=a) synwork._ppe_ME(in=b) synwork._ppe_MB(in=c) synwork._ppe_MM(in=d);
  if a then do; spec = 'DE'; spec_label = 'Daily dates, Efron'; end;
  else if b then do; spec = 'ME'; spec_label = 'Monthly dates, Efron'; end;
  else if c then do; spec = 'MB'; spec_label = 'Monthly dates, Breslow'; end;
  else do; spec = 'MM'; spec_label = 'Monthly dates, Efron, log(time + 15)'; end;
  keep spec spec_label Parameter Estimate StdErr;
run;

proc sql;
  create table synwork.plas_recovery as
  select r.spec, r.spec_label, t.ord, t.param, t.truth,
         r.Estimate, r.StdErr,
         r.Estimate - probit(0.975) * r.StdErr as lcl,
         r.Estimate + probit(0.975) * r.StdErr as ucl,
         r.Estimate - t.truth                  as bias,
         (r.Estimate - t.truth) / r.StdErr     as z,
         (t.truth between calculated lcl and calculated ucl) as covered
  from synwork._prec as r inner join synwork.plas_truth as t
    on upcase(r.Parameter) = upcase(t.param)
  order by r.spec, t.ord;
quit;

data synwork.plas_recovery;
  set synwork.plas_recovery;
  format truth Estimate StdErr lcl ucl bias 10.4 z 8.2;
run;
%export_csv(data=synwork.plas_recovery, name=plasmode_recovery)

/* Every coefficient, standard error, and -2 log partial likelihood of the
   four fits, compared with the Python fits of the identical data. */
%macro recovery_python_checks;
  %local s spec;
  %do s = 1 %to 4;
    %let spec = %scan(DE ME MB MM, &s);
    data _null_;
      set synwork.plas_recovery(where=(spec = "&spec"));
      call execute(cats('%nrstr(%check)(metric=plas_', "&spec", '_', param,
                        '_beta, actual=', put(Estimate, best16.), ', tol=0.00001)'));
      call execute(cats('%nrstr(%check)(metric=plas_', "&spec", '_', param,
                        '_se, actual=', put(StdErr, best16.), ', tol=0.00001)'));
    run;
    %m2ll_check(ds=synwork._pfit_&spec, tag=plas_&spec)
  %end;
%mend recovery_python_checks;

/* -2 log partial likelihood with covariates. */
%macro m2ll_check(ds=, tag=);
  %local v;
  proc sql noprint;
    select WithCovariates format=best16. into :v trimmed
    from &ds where compress(upcase(Criterion)) = '-2LOGL';
  quit;
  %check(metric=&tag._m2ll, actual=&v, tol=0.001)
%mend m2ll_check;
%recovery_python_checks

/* Side-by-side view: truth and the four estimates for each coefficient. */
proc sql;
  create table synwork._prec_wide as
  select t.ord, t.param, t.truth format=8.4,
         a.Estimate as daily_efron     format=8.4,
         b.Estimate as month_efron     format=8.4,
         c.Estimate as month_breslow   format=8.4,
         d.Estimate as month_efron_mid format=8.4,
         b.Estimate - c.Estimate as efron_minus_breslow format=10.6
  from synwork.plas_truth t
       left join synwork.plas_recovery(where=(spec='DE')) a on t.param = a.param
       left join synwork.plas_recovery(where=(spec='ME')) b on t.param = b.param
       left join synwork.plas_recovery(where=(spec='MB')) c on t.param = c.param
       left join synwork.plas_recovery(where=(spec='MM')) d on t.param = d.param
  order by t.ord;
quit;
title 'Plasmode recovery: true coefficients and estimates (log hazard ratio scale)';
proc print data=synwork._prec_wide noobs label;
  var param truth daily_efron month_efron month_breslow month_efron_mid efron_minus_breslow;
run;
title;

/* Recovery checks. The daily-date fit and the mid-month fit should each place
   every built-in effect within 3.29 standard errors of its true value (a
   two-sided 99.9 percent band). The monthly fits with log(time) are not
   checked, because the bias of the time-varying CHF terms under monthly
   dates is the point the table demonstrates. */
%macro recover_checks;
  %local s spec p i z;
  %do s = 1 %to 2;
    %let spec = %scan(DE MM, &s);
    %do i = 1 %to 6;
      %let p = %scan(chf chf_lt agec agec2 female diab, &i);
      proc sql noprint;
        select z format=best16. into :z trimmed from synwork.plas_recovery
        where spec = "&spec" and param = "&p";
      quit;
      %check_range(metric=plas_recover_&spec._&p._z, actual=&z, lo=-3.29, hi=3.29)
    %end;
  %end;
%mend recover_checks;
%recover_checks

/*------------------------------------------------------------------------------
  7. Figure. The CHF hazard ratio over time: the truth and the curves implied
     by three of the fits, each read at face value as a + b log(t).
------------------------------------------------------------------------------*/
proc sql noprint;
  select Estimate format=best16. into :_a_DE trimmed from synwork.plas_recovery where spec='DE' and param='chf';
  select Estimate format=best16. into :_b_DE trimmed from synwork.plas_recovery where spec='DE' and param='chf_lt';
  select Estimate format=best16. into :_a_ME trimmed from synwork.plas_recovery where spec='ME' and param='chf';
  select Estimate format=best16. into :_b_ME trimmed from synwork.plas_recovery where spec='ME' and param='chf_lt';
  select Estimate format=best16. into :_a_MM trimmed from synwork.plas_recovery where spec='MM' and param='chf';
  select Estimate format=best16. into :_b_MM trimmed from synwork.plas_recovery where spec='MM' and param='chf_lt';
quit;

data synwork._plcurve;
  length curve $48;
  do t = 15 to &admin_day by 5;
    months = t * 24 / &admin_day;
    curve = 'True';                                 hr = exp(&plas_chf_a + &plas_chf_b * log(t)); output;
    curve = 'Daily dates, Efron';                   hr = exp(&_a_DE + &_b_DE * log(t)); output;
    curve = 'Monthly dates, Efron, log(time)';      hr = exp(&_a_ME + &_b_ME * log(t)); output;
    curve = 'Monthly dates, Efron, log(time + 15)'; hr = exp(&_a_MM + &_b_MM * log(t)); output;
  end;
run;

%fig(plasmode_chf_tv)
title 'Plasmode: true and estimated CHF hazard ratio over follow-up';
proc sgplot data=synwork._plcurve;
  series x=months y=hr / group=curve lineattrs=(thickness=2) name='c';
  refline 1 / axis=y lineattrs=(pattern=dot);
  xaxis values=(0 to 24 by 3) label='Months since January 1, 2009';
  yaxis type=log logbase=10 label='CHF hazard ratio (log scale)';
  keylegend 'c' / title='' across=2;
run;
title;
%fig_end

/*------------------------------------------------------------------------------
  8. Replicate study. &plas_reps simulated outcomes on one fixed subsample of
     &plas_subn people, the people with the smallest draw-0 uniforms (the
     covariates stay the same, only the outcome is redrawn). Reports bias, empirical standard deviation, average
     model standard error, and 95 percent confidence interval coverage for the
     three monthly-date fits. The daily-date fit is left out because, with
     730 distinct event times and a programming statement, it is much
     slower than the others, and section 6 already shows it on the full data.
------------------------------------------------------------------------------*/
%macro plas_replicates;
  %if &plas_reps <= 0 %then %do;
    %put NOTE: [plasmode] plas_reps = 0, replicate study skipped.;
    %return;
  %end;

  %hash_sample(data=synwork._plbase, out=synwork._plsub, n=&plas_subn)

  data synwork._plrep;
    _crate = -log(1 - &plas_cens_2yr) / &admin_day;
    do rep = 1 to &plas_reps;
      do _i = 1 to _nobs;
        set synwork._plsub nobs=_nobs point=_i;
        %_plas_generate(2 * rep + 1, 2 * rep + 2)
        output;
      end;
    end;
    stop;
    keep rep time event &plcovs;
  run;

  /* Printed output is switched off for the replicate fits only. */
  ods exclude all;
  ods output ParameterEstimates = synwork._rpe_ME ConvergenceStatus = synwork._rcs_ME;
  %plas_fit(spec=ME, tvar=time, ties=efron,   data=synwork._plrep, by=rep)
  ods output ParameterEstimates = synwork._rpe_MB ConvergenceStatus = synwork._rcs_MB;
  %plas_fit(spec=MB, tvar=time, ties=breslow, data=synwork._plrep, by=rep)
  ods output ParameterEstimates = synwork._rpe_MM ConvergenceStatus = synwork._rcs_MM;
  %plas_fit(spec=MM, tvar=time, ties=efron, off=15, data=synwork._plrep, by=rep)
  ods exclude none;

  data synwork._rpe;
    length spec $2 Parameter $32 Label $256;
    set synwork._rpe_ME(in=a) synwork._rpe_MB(in=b) synwork._rpe_MM(in=c);
    spec = ifc(a, 'ME', ifc(b, 'MB', 'MM'));
    keep spec rep Parameter Estimate StdErr;
  run;
  data synwork._rcs;
    length spec $2;
    set synwork._rcs_ME(in=a) synwork._rcs_MB(in=b) synwork._rcs_MM(in=c);
    spec = ifc(a, 'ME', ifc(b, 'MB', 'MM'));
    keep spec rep Status;
  run;

  proc sql;
    create table synwork.plas_reps as
    select r.spec, t.ord, t.param, t.truth,
           count(*)                         as n_reps,
           mean(r.Estimate)                 as mean_est,
           mean(r.Estimate) - t.truth       as bias,
           std(r.Estimate)                  as emp_sd,
           mean(r.StdErr)                   as mean_se,
           mean(t.truth between r.Estimate - probit(0.975) * r.StdErr
                            and r.Estimate + probit(0.975) * r.StdErr) as coverage
    from synwork._rpe as r inner join synwork.plas_truth as t
      on upcase(r.Parameter) = upcase(t.param)
    where t.ord <= 6
    group by r.spec, t.ord, t.param, t.truth
    order by r.spec, t.ord;

    select count(*) into :_nconv_fail trimmed from synwork._rcs where Status ne 0;
  quit;
  %if &_nconv_fail > 0 %then
    %put WARNING: [plasmode] &_nconv_fail replicate fits did not converge.;

  data synwork.plas_reps;
    set synwork.plas_reps;
    format truth mean_est bias emp_sd mean_se 10.4 coverage 6.3;
  run;

  data _null_;
    set synwork.plas_reps;
    length m $64;
    m = cats('plas_rep_', spec, '_', param);
    call execute(cats('%nrstr(%check)(metric=', m, '_mean, actual=', put(mean_est, best16.), ', tol=0.00001)'));
    call execute(cats('%nrstr(%check)(metric=', m, '_sd, actual=',   put(emp_sd,   best16.), ', tol=0.00001)'));
    call execute(cats('%nrstr(%check)(metric=', m, '_se, actual=',   put(mean_se,  best16.), ', tol=0.00001)'));
    call execute(cats('%nrstr(%check)(metric=', m, '_cov, actual=',  put(coverage, best16.), ', tol=1e-9)'));
  run;

  title "Plasmode replicate study (&plas_reps replicates, n = &plas_subn)";
  proc print data=synwork.plas_reps noobs;
  run;
  title;
  %export_csv(data=synwork.plas_reps, name=plasmode_replicates)
%mend plas_replicates;
%plas_replicates
